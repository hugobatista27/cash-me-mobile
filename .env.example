# URL base da API backend (obrigatória ao testar em dispositivo físico na mesma rede Wi-Fi)
# Substitua pelo IP local da sua máquina (ex: ip addr / ifconfig)
# No emulador Android, se omitida, usa http://10.0.2.2:3333/api/v1
# No iOS Simulator e Web, se omitida, usa http://localhost:3333/api/v1
EXPO_PUBLIC_API_URL=http://192.168.0.10:3333/api/v1
